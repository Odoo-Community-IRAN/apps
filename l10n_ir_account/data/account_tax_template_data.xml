<odoo>
    <!-- sale taxes -->
    <record id="ir_sale_tax_10" model="account.tax.template">
        <field name="chart_template_id" ref="l10n_ir_chart_template" />
        <field name="name">10٪ ارزش افزوده فروش</field>
        <field name="description">10٪ ارزش افزوده فروش</field>
        <field name="amount">10</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">sale</field>
        <field name="tax_group_id" ref="ir_tax_group_10" />
        <field
            name="invoice_repartition_line_ids"
            eval="[(5, 0, 0),
            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'base',
            }),

            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'tax',
                'account_id': ref('account_account_template_0_211006'),
            }),
        ]"
        />
        <field
            name="refund_repartition_line_ids"
            eval="[(5, 0, 0),
            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'base',
            }),

            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'tax',
                'account_id': ref('account_account_template_0_211006'),
            }),
        ]"
        />
    </record>
    <!-- purchase taxes -->
    <record id="ir_purchase_tax_10" model="account.tax.template">
        <field name="chart_template_id" ref="l10n_ir_chart_template" />
        <field name="name">10٪ ارزش افزوده خرید</field>
        <field name="description">10٪ ارزش افزوده خرید</field>
        <field name="amount">10</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">purchase</field>
        <field name="tax_group_id" ref="ir_tax_group_10" />
        <field
            name="invoice_repartition_line_ids"
            eval="[(5, 0, 0),
            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'base',
            }),

            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'tax',
                'account_id': ref('account_account_template_0_211006'),
            }),
        ]"
        />
        <field
            name="refund_repartition_line_ids"
            eval="[(5, 0, 0),
            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'base',
            }),

            (0,0, {
                'factor_percent': 100,
                'repartition_type': 'tax',
                'account_id': ref('account_account_template_0_211006'),
            }),
        ]"
        />
    </record>

</odoo>
