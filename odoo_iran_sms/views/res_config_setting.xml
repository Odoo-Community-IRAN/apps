<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sms.kavenegar</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="sms.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@service_name='sms']" position="before">
                <field name="sms_provider" class="o_light_label" widget="radio" options="{'horizontal': true}" required="True"/>
                <div class="content-group" invisible="sms_provider != 'kavenegar'">
                    <button name="action_open_kavenegar_sms_provider" icon="oi-arrow-right"
                            type="object" class="btn-link"
                            string="Configure Kavenegar SMS Provider"/>
                </div>
            </xpath>
            <xpath expr="//widget[@service_name='sms']" position="attributes">
                <attribute name="invisible">sms_provider == 'kavenegar'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
