<odoo>
    <record id="payment_provider_form_inherit_payment_zarinpal" model="ir.ui.view">
        <field name="name">Adyen Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr='//group[@name="provider_credentials"]' position='inside'>
                <group attrs="{'invisible': [('code', '!=', 'zarinpal')]}">
                    <field name="zarinpal_merchant_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
